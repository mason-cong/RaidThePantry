# ---------------------------------------------------------------------------
# TLS material for the Caddy-fronted production deploy
# ---------------------------------------------------------------------------
# The Cloudflare Origin CA certificate and key that docker-compose.prod.yml
# mounts into Caddy. Placed on the server by hand; never belongs in the repo.
certs/

# ---------------------------------------------------------------------------
# Scraper working files
# ---------------------------------------------------------------------------
# Crawl input lists and any dumped pages are local working data, often large,
# and may carry third-party content that shouldn't be redistributed.
urls.txt
crawl/
scrape-output/
*.scrapelog

# ---------------------------------------------------------------------------
# OS noise (this tree lives under OneDrive, so desktop.ini matters)
# ---------------------------------------------------------------------------
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store

# ---------------------------------------------------------------------------
# Explicitly tracked despite the rules above
# ---------------------------------------------------------------------------
# EF migrations are source, not build output — they must be committed.
!**/Migrations/
!**/Migrations/**
