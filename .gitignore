# ---------------------------------------------------------------------------
# Secrets and machine-specific configuration
# ---------------------------------------------------------------------------
# appsettings.Development.json holds the local Postgres credentials and will
# hold more once auth lands. Track appsettings.Development.example.json instead
# and copy it locally: real secrets belong in `dotnet user-secrets`, which
# stores them outside the repo entirely.
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.snk
.env
.env.*
!.env.example

