# Build output — rebuilt inside the image, and copying host artifacts in is how
# you get a Linux image containing Windows binaries.
**/bin
**/obj
**/node_modules
**/dist

# Secrets and local configuration. appsettings.Development.json holds the local
# database password and turns on Scraping:AllowLoopbackHosts; neither belongs in
# a shipped image.
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.*.Local.json
**/*.user
.env
.env.*

# Internal planning documents, kept out of the repo and out of the image.
*-implementation-plan.md
recipe-api-implementation-plan.md
docs/internal
notes

# Not needed to build or run the app.
.git
.github
.gitignore
.gitattributes
.vs
.vscode
.idea
tests
fixtures
urls.txt
scrape-output
docker-compose*.yml
README.md
