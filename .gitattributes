# Normalize line endings: store LF in the repo, check out native on Windows.
# Without this, files authored with LF churn against Windows tooling that
# rewrites them as CRLF, producing whole-file diffs on untouched files.
* text=auto

# Explicitly text
*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.sln       text eol=crlf
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.sql       text
*.http      text

# LF regardless of platform. These are read by Linux, inside a container or on
# the VM, and a CRLF line ending is not cosmetic there: a shebang followed by
# \r makes the kernel look for an interpreter named "bash\r" and the script
# fails with "bad interpreter". The same applies to anything the shell sources.
*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
.env.example text eol=lf

# Explicitly binary — never munge these
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.pfx       binary
*.snk       binary
*.dll       binary
*.exe       binary
