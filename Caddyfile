# TLS is obtained and renewed automatically from Let's Encrypt.
#
# There is deliberately no `tls` directive and no certificate on disk: Caddy
# provisions one the first time the site is requested, then renews it on its own.
#
# Two things this depends on, both easy to get wrong:
#
#   1. DNS for {$DOMAIN} must already resolve to this host before the stack
#      starts. Let's Encrypt validates by connecting back on port 80, so a name
#      that does not resolve yet fails issuance — and repeated failures count
#      against a rate limit that locks you out for hours.
#
#   2. Port 80 must stay open to the world. It is not only the redirect: it is
#      how the HTTP-01 challenge reaches Caddy. Restricting it to a CDN's
#      address range breaks renewal, silently, about sixty days later.
#
# There is also no explicit `:80` block. Caddy's automatic HTTPS already answers
# the ACME challenge there and redirects everything else to HTTPS; adding a
# catch-all of our own would shadow the challenge endpoint.

{
	# Where Let's Encrypt sends expiry and problem notices. Not required, but
	# the one warning you actually want to receive.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# "api" resolves over the compose network, so this never leaves the host.
	# The api container publishes nothing publicly — Caddy is the only way in.
	reverse_proxy api:8080
}
