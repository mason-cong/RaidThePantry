# Copy to `.env` next to docker-compose.prod.yml and fill in. Compose reads
# `.env` from that directory automatically, so nothing here needs exporting.
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` itself is gitignored and must stay that way — it holds two secrets.

# ---------------------------------------------------------------------------
# The site
# ---------------------------------------------------------------------------
# Caddy asks Let's Encrypt for a certificate covering exactly this name, so it
# has to resolve to this host *before* the stack starts. No scheme, no path,
# no trailing dot.
DOMAIN=raidthepantry.ca

# Where Let's Encrypt sends expiry and problem notices. Not validated, and not
# published anywhere, but it is the one warning you actually want to receive.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Secrets — generate these on the server, do not reuse an example
# ---------------------------------------------------------------------------
# Signs the auth tokens. 32 bytes minimum; the app refuses to start on a
# shorter one. Changing it later invalidates every session at once.
#
#   openssl rand -base64 32
JWT_SIGNING_KEY=

# Postgres only listens on the internal compose network — it publishes no port
# at all — but set a real one anyway.
#
# Set this BEFORE the first `up`. Postgres applies it while initializing an
# empty data directory and never reads it again, so changing it afterwards
# leaves the database on the old password and the API unable to connect. If
# that happens, either put the old value back or `ALTER USER recipeapi
# PASSWORD ...` inside the container.
#
#   openssl rand -base64 24
POSTGRES_PASSWORD=
